# Database (Neon PostgreSQL)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/mcphub

# Redis (Upstash)
REDIS_URL=redis://localhost:6379

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/dashboard
NEXT_PUBLIC_CRON_SECRET=changeme-cron-secret

# App
APP_ENV=development
SECRET_KEY=changeme-use-a-long-random-string
ALLOWED_ORIGINS=http://localhost:3000

# Notifications (optional)
SLACK_WEBHOOK_URL=
ALERT_WEBHOOK_URL=

# Vercel Cron (set to a secret string, pass as Authorization: Bearer <secret>)
CRON_SECRET=changeme-cron-secret
